# OCP-compatible nginx configuration — TEMPLATE.
#
# This file is NOT used as-is. docker-entrypoint.sh renders it to
# /etc/nginx/conf.d/default.conf at container start (via envsubst), substituting
# the ${...} placeholders below from environment variables. Edit THIS template;
# never edit the rendered default.conf inside a running container.
#
# Backend URLs are injected from the frontend deployment YAML
# (services.frontend.config.backends.* in the Helm values) as env vars. Because
# every proxy_pass uses an nginx *variable* ($backend) instead of a literal
# hostname, nginx does NOT resolve the upstreams at startup. They are resolved
# per request via the `resolver` below, so a backend that is down or not yet
# deployed produces a 502 on that one route — it can no longer prevent nginx
# (and therefore the whole frontend pod) from booting.

server {
    listen 8080;
    server_name localhost;

    # Allow file uploads up to 100MB (for archive import)
    client_max_body_size 100m;

    # Cluster DNS for request-time upstream resolution. Injected at startup:
    # kube-dns in Kubernetes/OCP, 127.0.0.11 in Docker. (NGINX_RESOLVER)
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;
    resolver_timeout 5s;

    location / {
        root /usr/share/nginx/html;
        index index.html index.htm;
        try_files $uri $uri/ /index.html;

        # Disable caching for HTML files (always get a fresh entrypoint, so a
        # redeploy never serves a stale index.html pointing at old asset hashes).
        location ~* \.html$ {
            add_header Cache-Control "no-cache, no-store, must-revalidate";
            add_header Pragma "no-cache";
            add_header Expires "0";
        }

        # Cache hashed static assets. Missing assets 404 here (this regex
        # location has no try_files), they never fall back to index.html.
        location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
            add_header Cache-Control "public, max-age=604800, must-revalidate";
            etag on;
        }
    }

    # --- API / hub proxies -------------------------------------------------
    # Upstream URLs come from the deployment env. proxy_pass uses the $backend
    # variable so resolution is deferred to request time (see header note).

    # InvalidRecords service (BACKEND_INVALIDRECORDS_URL)
    location /api/v1/invalid-records {
        set $backend "${BACKEND_INVALIDRECORDS_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # Metrics Configuration service (BACKEND_METRICS_URL)
    location /api/v1/metrics {
        set $backend "${BACKEND_METRICS_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # Global Alerts — served by Metrics Configuration (BACKEND_METRICS_URL)
    location /api/v1/global-alerts {
        set $backend "${BACKEND_METRICS_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # Scheduling service (BACKEND_SCHEDULING_URL)
    location /api/v1/scheduling {
        set $backend "${BACKEND_SCHEDULING_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # Schema — proxied through DataSourceManagement (BACKEND_DATASOURCE_URL)
    location /api/v1/schema {
        set $backend "${BACKEND_DATASOURCE_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    # SignalR hub — InvalidRecords (BACKEND_INVALIDRECORDS_URL)
    location /hubs/invalid-records {
        set $backend "${BACKEND_INVALIDRECORDS_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # SignalR hub — DataSourceManagement and others (BACKEND_DATASOURCE_URL)
    location /hubs/ {
        set $backend "${BACKEND_DATASOURCE_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $http_connection;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 86400s;
        proxy_send_timeout 86400s;
    }

    # Default API fallback — DataSourceManagement (BACKEND_DATASOURCE_URL)
    location /api/ {
        set $backend "${BACKEND_DATASOURCE_URL}";
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_cache_bypass $http_upgrade;
    }

    error_page 500 502 503 504 /50x.html;
    location = /50x.html {
        root /usr/share/nginx/html;
    }
}
